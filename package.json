{
  "name": "script-alquileres",
  "private": true,
  "version": "0.0.0",
  "description": "Rental property scraper with React UI",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run frontend\"",
    "frontend": "vite",
    "server": "npx nodemon --watch server.js server.js",
    "python:all": "concurrently \"npm run python:argenprop\" \"npm run python:zonaprop\"",
    "python:argenprop": "while true; do python scriptArgenProp.py; sleep 300; done",
    "python:zonaprop": "while true; do python scriptZonaProp.py; sleep 300; done",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.6",
    "@mui/material": "^5.15.6",
    "@reduxjs/toolkit": "^2.7.0",
    "axios": "^1.6.7",
    "bluebird": "^3.7.2",
    "cheerio": "^1.0.0-rc.12",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "nodemon": "^3.0.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0"
  }
}
